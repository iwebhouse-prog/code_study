# Copy to .env and fill in real values: cp .env.example .env
# .env is read by docker-compose.yml and the backend. Never commit .env.

# --- PostgreSQL (docker-compose `db` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codelearning

# Backend runs on the host. Use 127.0.0.1, not localhost: on Windows
# "localhost" tries IPv6 first and adds ~2s to every connection.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/codelearning

# Connection pool (requirements-addendum CHK105). Remove a line to use the default.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_COMMAND_TIMEOUT=30

# --- Redis (Celery broker + cache) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Google AI (Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=change-me-google-api-key
GEMINI_MODEL=gemini-3-flash-preview

# --- JWT (generate each secret with: openssl rand -hex 32) ---
JWT_SECRET_KEY=change-me-access-token-secret
JWT_REFRESH_SECRET=change-me-refresh-token-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
DEBUG=true
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# --- File storage ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=10
